{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" },
      { "name": "shareType", "value": "pixelshop-lut" },
      { "name": "shareBundleName", "value": "com.example.pixel_shop" },
      { "name": "client_id", "value": "6917616314301783579" }
    ],
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:wifi_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:write_media_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.GET_WIFI_INFO",
        "reason": "$string:wifi_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.SET_WIFI_INFO",
        "reason": "$string:wifi_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:location_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:location_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:bluetooth_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        // 预览模式下参数文字要跟着**设备实际朝向**摆正（画面是锁 90° 的，文字是给
        // 人读的，两者目标不同），需要一个重力向量。系统授权级，不弹窗。
        "name": "ohos.permission.ACCELEROMETER",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      },
      {
        "name": "ohos.permission.APP_TRACKING_CONSENT",
        "reason": "$string:device_id_reason",
        "usedScene": {
          "when": "inuse",
          "abilities": [
            "EntryAbility"
          ]
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:vivid_app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:vivid_app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "orientation": "auto_rotation",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "linkFeature": "FileOpen",
                "type": "general.json",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
