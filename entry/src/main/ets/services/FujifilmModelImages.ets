  /** 归一化：大写、去掉所有非字母数字，用于宽松匹配（GFX 100 == GFX100）。 */
  static normalize(name: string): string {
    let out = '';
    const upper = name.toUpperCase();
    for (let i = 0; i < upper.length; i++) {
      const ch = upper.charAt(i);
      if ((ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')) out += ch;
    }
    return out;
  }

  /** 机型名 -> 素材条目；找不到返回 null。 */
  static find(name: string): FujifilmModelArt | null {
    const key = FujifilmModelImages.normalize(name);
    if (key.length === 0) return null;
    for (const art of FujifilmModelImages.ALL) {
      if (FujifilmModelImages.normalize(art.model) === key) return art;
    }
    for (const art of FujifilmModelImages.ALL) {
      const artKey = FujifilmModelImages.normalize(art.model);
      if (artKey.length > 0 && (artKey.indexOf(key) >= 0 || key.indexOf(artKey) >= 0)) return art;
    }
    return null;
  }

  /** rawfile 相对路径；找不到时回退到通用占位图。 */
  static rawfileOf(name: string): string {
    const art = FujifilmModelImages.find(name);
    return art !== null ? 'fujifilm/' + art.slug + '.png' : 'fujifilm/generic.png';
  }
